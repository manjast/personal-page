---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CTASection from '../../components/CTASection.astro';
import { getSiteContent } from '../../config/site';
import { localizedHref } from '../../i18n/routing';

const locale = 'sr';
const content = getSiteContent(locale);
const { siteConfig } = content;
const caseStudies = (await getCollection('case-studies'))
  .filter((entry) => entry.data.locale === locale)
  .sort((left, right) => left.data.order - right.data.order);
const primaryCta = { ...siteConfig.heroPrimaryCta, href: localizedHref(locale, siteConfig.heroPrimaryCta.href) };
---

<BaseLayout
  locale={locale}
  pathname="/sr/work/"
  title="Пројекти интерних AI система"
  description="Прикази интерних AI система изграђених за стварне пословне процесе, са нагласком на то како су постављени, испоручени и шта су дали у пракси."
  pageSchema={[
    {
      '@type': 'CollectionPage',
      '@id': `${siteConfig.siteUrl}/sr/work/#webpage`,
      url: `${siteConfig.siteUrl}/sr/work/`,
      name: 'Пројекти интерних AI система | Стефан Мања',
      description: 'Прикази интерних AI система изграђених за стварне пословне процесе, са нагласком на то како су постављени, испоручени и шта су дали у пракси.',
      author: { '@id': `${siteConfig.siteUrl}/#person` },
      inLanguage: 'sr-Cyrl',
    },
  ]}
>
  <SiteHeader locale={locale} />

  <main id="main">
    <section class="section-space page-start">
      <div class="shell">
        <div class="page-lead">
          <div class="flex flex-wrap items-center gap-3">
            <span class="section-marker">01 / пројекти</span>
            <p class="eyebrow">Пројекти</p>
          </div>
          <h1 class="page-title">
            Како су системи постављени, испоручени и шта су дали у пракси.
          </h1>
          <p class="text-base leading-8 muted-copy">
            Ови прикази су намерно селективни: довољни да покажу проблем, приступ решењу и доказ испоруке, без
            откривања интерног материјала који треба да остане интерни. Тренутни јавни примери долазе из рада у
            Делта Холдингу; спољни клијентски пројекти биће додати када буду могли да се објаве.
          </p>
        </div>

        <div class="section-break panel panel-light mt-10 px-6 py-8 sm:px-10">
          <div class="max-w-3xl space-y-4">
            <p class="eyebrow">Како читати доказе</p>
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
              Ове приказе треба читати по томе шта се променило, не по броју тврдњи.
            </h2>
            <p class="text-sm leading-7 text-[color:var(--ink-soft)]">
              Сваки приказ је јавно безбедан и намерно селективан. Корисни доказ је облик процеса, скуп ограничења,
              оперативне одлуке и мерљив резултат.
            </p>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <article class="rounded-2xl border border-[color:var(--rule)] bg-white/80 p-4">
              <p class="metric-label text-[color:var(--accent)]">Промењени процес</p>
              <p class="mt-3 text-sm leading-7 text-[color:var(--ink-soft)]">Који процес се променио, ко користи резултат и где је људско расуђивање остало у петљи.</p>
            </article>
            <article class="rounded-2xl border border-[color:var(--rule)] bg-white/80 p-4">
              <p class="metric-label text-[color:var(--accent)]">Облик система</p>
              <p class="mt-3 text-sm leading-7 text-[color:var(--ink-soft)]">Зашто је решење постало слој препорука, интерни асистент, стабилизација или одлука да AI систем није потребан.</p>
            </article>
            <article class="rounded-2xl border border-[color:var(--rule)] bg-white/80 p-4">
              <p class="metric-label text-[color:var(--accent)]">Оперативна ограничења</p>
              <p class="mt-3 text-sm leading-7 text-[color:var(--ink-soft)]">Приступ, провера, власништво, увид у трошкове и предаја тиму део су доказа, не споредни детаљи имплементације.</p>
            </article>
            <article class="rounded-2xl border border-[color:var(--rule)] bg-white/80 p-4">
              <p class="metric-label text-[color:var(--accent)]">Мерљив резултат</p>
              <p class="mt-3 text-sm leading-7 text-[color:var(--ink-soft)]">Исход или коришћење приказују се само тамо где је мерење јавно безбедно.</p>
            </article>
          </div>
        </div>

        <h2 class="visually-hidden">Пројекти</h2>
        <div class="mt-10 grid gap-4 lg:grid-cols-2">
          {caseStudies.map((entry) => <CaseStudyCard entry={entry} locale={locale} />)}
        </div>
      </div>
    </section>

    <CTASection
      eyebrow={content.ui.ctaEyebrow}
      title="Ако имате сличан интерни AI процес за који треба развити систем или га довести до стварне употребе, могу да проценим одакле има смисла кренути."
      description="Кратак опис процеса, корисника, тренутне фазе и ограничења обично је довољан да се процени да ли израда система или саветовање имају смисла."
      primary={primaryCta}
      secondary={{ href: '/sr/services/', label: 'Погледајте полазне тачке' }}
    />
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>
