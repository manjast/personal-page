---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CTASection from '../../components/CTASection.astro';
import { getSiteContent, siteConfig } from '../../config/site';
import { type Locale } from '../../i18n/routing';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries
    .filter((entry) => !entry.data.draft && entry.data.locale === 'en')
    .map((entry) => ({
      params: { slug: entry.data.routeSlug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const content = getSiteContent(entry.data.locale);
const detailPath = `/writing/${entry.data.routeSlug}/`;
const canonicalUrl = `${siteConfig.siteUrl}${detailPath}`;

const allWriting = (await getCollection('writing')).filter((e) => !e.data.draft);
const siblings = allWriting.filter(
  (candidate) => candidate.data.translationKey === entry.data.translationKey,
);
const translatedAlternates = siblings.reduce(
  (paths, candidate) => ({
    ...paths,
    [candidate.data.locale]: `/writing/${candidate.data.routeSlug}/`,
  }),
  {} as Partial<Record<Locale, string>>,
);
const alternates = {
  ...translatedAlternates,
  'x-default': translatedAlternates.en ?? detailPath,
};
---

<BaseLayout
  locale={entry.data.locale}
  pathname={detailPath}
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.ogImage}
  ogType="article"
  alternates={alternates}
  pageSchema={[
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      url: canonicalUrl,
      headline: entry.data.title,
      description: entry.data.summary,
      datePublished: entry.data.publishedAt.toISOString(),
      mainEntityOfPage: canonicalUrl,
      author: { '@id': `${siteConfig.siteUrl}/#person` },
      publisher: { '@id': `${siteConfig.siteUrl}/#person` },
      inLanguage: entry.data.locale,
    },
  ]}
>
  <SiteHeader alternates={alternates} />

  <main id="main">
    <section class="pt-10 pb-16 sm:pt-10 sm:pb-20">
      <div class="shell">
        <a
          class="ink-link inline-flex min-h-[44px] items-center py-2 text-sm font-semibold transition"
          href="/writing/"
        >
          ← Selected writing
        </a>

        <div class="mt-8 max-w-3xl">
          <p class="eyebrow">{content.ui.ctaEyebrow}</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{entry.data.title}</h1>
          <p class="mt-4 text-lg leading-8 muted-copy">{entry.data.summary}</p>
          <p class="mt-3 text-sm muted-copy"><time datetime={entry.data.publishedAt.toISOString()}>{entry.data.displayDate}</time></p>

          <article class="content-body mt-10">
            <Content />
          </article>
        </div>
      </div>
    </section>

    <CTASection
      title="If you have a similar internal AI workflow to build or harden, I can review the workflow shape."
      description="A short note on the workflow, users, current stage, and constraints is usually enough to tell whether build or advisory work makes sense."
      primary={siteConfig.heroPrimaryCta}
      secondary={{ href: '/work', label: 'View selected work' }}
    />
  </main>

  <SiteFooter />
</BaseLayout>
